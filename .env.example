# Closeli Remote Stream Server
# Copy to .env and fill in your values
#
# Usage:
#   python3 relay_remote_client.py                 # Auto-discover all cameras
#   python3 relay_remote_client.py -d xxxxS_abc123 # Single camera only
#   python3 relay_remote_client.py --discover-only  # List cameras, then exit
#   docker compose up -d                            # Run in container
#
# Endpoints (cameras auto-discovered):
#   http://localhost:8080/                          - Index (all cameras)
#   http://localhost:8080/video/<device_id>         - MJPEG stream
#   http://localhost:8080/audio/<device_id>         - Audio stream
#   http://localhost:8080/status                    - All cameras status

# =============================================================================
# Closeli Account
# =============================================================================
CLOSELI_EMAIL=user@example.com
CLOSELI_PASSWORD=your_password

# =============================================================================
# Product Credentials (from APK)
# =============================================================================
# Eoolii (abroad)
PRODUCT_KEY=c90466a2-6ea
PRODUCT_SECRET=PzEIWxPeAwuNF8sWRzc9

# YCC365 Plus (extracted from res/xDY.ini)
# PRODUCT_KEY=6f425be2-e27
# PRODUCT_SECRET=WXKGtS0yQuMd6uqxq5KR

# =============================================================================
# ONVIF PTZ (optional) — expose cameras to Frigate as ONVIF PTZ devices
# =============================================================================
# Frigate controls PTZ only over ONVIF. When enabled, the relay client starts ONE
# ONVIF listener (shared by all cameras) on ONVIF_PORT. In Frigate, point every
# camera's onvif.host/port at it and set onvif.user to that camera's device id
# (onvif.password can be anything) — the shim routes each command by the user.
# Manual pan/tilt d-pad only — no zoom, presets, or autotracking (the camera has
# no position feedback). Requires lxml (in requirements.txt).
# ONVIF_ENABLED=true
# ONVIF_PORT=8091
